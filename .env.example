# Lucy does not read provider API keys from VITE_* build variables. Add personal
# Gemini and Tavily keys in Settings so production builds do not embed a shared key.

# Release builds: set this in the shell/CI environment before running `pnpm tauri build`.
# It must be the 32-byte Ed25519 PUBLIC verification key matching the license issuer.
# Do not put the signing/private key in this project or any client build.
VITE_ED25519_PUBLIC_KEY=<64-character-hex-public-key>

# The app currently uses its configured production license service URL in source.
# Change that service endpoint in the application configuration when self-hosting.
