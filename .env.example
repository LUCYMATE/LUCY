# Desktop Client App (.env) - Soltini
# Place this file in d:\all voice assistance\soltini\soltini\.env

# 1. Main Google Gemini API Key (Required for 3D AI Voice & Real-time Vision)
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=AIzaSyBQPAMWTuPLk0T8IaXEszYepLT8z7LshVs

# 2. Alternative Gemini API Key (Optional fallback when main key hits rate limit)
VITE_ALT_GEMINI_API_KEY=

# 3. Tavily Search API Key (Optional for real-time web search)
# Get from: https://tavily.com
VITE_TAVILY_API_KEY=

# 4. Soltini License & Authentication Server URL
VITE_LICENSE_SERVER_URL=https://soltini.vercel.app
