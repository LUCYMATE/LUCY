{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-cursor-position",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-skip-taskbar",
    "core:window:allow-set-shadow",
    "core:window:allow-set-resizable",
    "core:window:allow-hide",
    "core:webview:allow-clear-all-browsing-data",
    "allow-start-native-mic",
    "allow-open-dashboard-window-command",
    "allow-stop-native-mic",
    "allow-start-native-wake-listener",
    "allow-stop-native-wake-listener",
    "allow-set-native-mic-boost",
    "allow-list-native-microphones",
    "allow-check-microphone-permission",
    "allow-open-microphone-privacy-settings",
    "allow-get-system-stats",
    "allow-open-external-url",
    "allow-move-and-click-mouse",
    "allow-type-string",
    "allow-run-python-script",
    "allow-run-terminal-command",
    "allow-press-key",
    "allow-scroll-mouse",
    "allow-press-key-combo",
    "allow-capture-screen",
    "allow-save-3d-asset",
    "allow-delete-3d-asset",
    "allow-list-3d-assets",
    "allow-read-3d-asset",
    "allow-get-3d-asset-path",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "allow-get-device-hwid",
    "allow-start-auth-callback",
    "allow-take-auth-callback",
    "allow-verify-license",
    "allow-check-authorization",
    "allow-logout-license",
    "allow-trim-memory",
    "allow-enter-sleep-mode",
    "allow-wake-up-main",
    "allow-is-autostart",
    "allow-get-desktop-rectangles",
    "allow-get-lucy-link-pairing-data",
    "allow-send-prompt-to-phone",
    "allow-resolve-mobile-prompt",
    "allow-get-lucy-link-status",
    "autostart:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.tavily.com/**"
        },
        {
          "url": "https://generativelanguage.googleapis.com/**"
        },
        {
          "url": "https://lucymate.vercel.app/**"
        }
      ]
    },
    "fs:default",
    "allow-read-3d-asset-bytes"
  ]
}
