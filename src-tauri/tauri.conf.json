{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Soltini",
  "version": "1.0.0",
  "identifier": "com.soltini.avatar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Soltini",
        "width": 1000,
        "height": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "visible": false,
        "skipTaskbar": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "additionalBrowserArgs": "--use-fake-ui-for-media-stream --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "scope": ["$APPLOCALDATA/**", "$APPCONFIG/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
